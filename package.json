{
  "name": "@civ-clone/base-city-auto-build",
  "version": "0.1.0",
  "description": "A city on Auto choosing its own next build: what it may choose, and the rules that make it choose when its build is finished, can no longer be built, or it has nothing to build.",
  "repository": "git@github.com:civ-clone/base-city-auto-build.git",
  "keywords": [
    "typescript",
    "civilization"
  ],
  "author": "dom111 <dom111@users.noreply.github.com>",
  "license": "MIT",
  "private": false,
  "files": [
    "lib/*.ts",
    "lib/*.js",
    "lib/*.js.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run ts:compile && npm run prettier:format",
    "prettier:check": "prettier --config .prettierrc --check '**/*.ts'",
    "prettier:format": "prettier --config .prettierrc '**/*.ts' --write",
    "test": "ts-mocha ./tests/*.test.ts",
    "ts:compile": "tsc --build tsconfig.json"
  },
  "devDependencies": {
    "@types/chai": "^4.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^16.0.0",
    "chai": "^4.0.0",
    "mocha": "^10.0.0",
    "prettier": "^2.8.8",
    "ts-mocha": "^10.0.0",
    "typescript": "^4.0.0"
  },
  "dependencies": {
    "@civ-clone/core-city": "^0.1.24",
    "@civ-clone/core-city-build": "^0.1.22",
    "@civ-clone/core-city-improvement": "^0.1.5",
    "@civ-clone/core-player": "^0.1.10",
    "@civ-clone/core-rule": "^0.1.9",
    "@civ-clone/core-unit": "^0.1.31"
  }
}
